APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REAL_DEBRID_API_TOKEN=
REAL_DEBRID_REMOTE_TRAFFIC=true
REAL_DEBRID_PROXY="socks5://KADI:SIFRE@IP:PORT"

XENFORO_URL=https://turkcesesindir.com
XENFORO_DB_HOST=127.0.0.1
XENFORO_DB_PORT=3306
XENFORO_DB_DATABASE=xenforo
XENFORO_DB_USERNAME=root
XENFORO_DB_PASSWORD=
XENFORO_DB_PREFIX=xf_

# İzin verilen XenForo kullanıcı grubu ID'leri (Virgülle ayırarak yazın, örn: 2,3,4. Boşsa hepsi girebilir)
XENFORO_ALLOWED_USER_GROUPS=3,4,5,11,20,23

# Superuser Yönetici Giriş Bilgileri
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=supersecretpass

# Cron Güvenlik Tokenı (Opsiyonel)
CRON_SECRET=